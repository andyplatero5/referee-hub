# Copia este archivo a .env (nunca se versiona).

# URL del frontend bajo prueba.
#   local:      http://localhost:5173
#   staging:    https://<tu-app>-staging.vercel.app
#   producción: https://<tu-app>.vercel.app   (solo smoke tests de lectura)
BASE_URL=http://localhost:5173

# URL de la API bajo prueba.
#   local:      http://localhost:3000
#   staging:    https://<tu-api>-staging.onrender.com
API_URL=http://localhost:3000

# Pon cualquier valor para que Playwright levante la API y el preview del frontend (requiere build previo).
# START_SERVERS=1
