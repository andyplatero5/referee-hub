# Copia este archivo a .env (nunca se versiona) y completa los valores.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Neon: usa la rama de desarrollo.
# DATABASE_URL = cadena con pooler (para la app); DIRECT_URL = cadena directa (para migraciones).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Opcional: versión que expone /health (en Render se usa RENDER_GIT_COMMIT).
# APP_VERSION=dev
