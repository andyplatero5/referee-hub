# Copia este archivo a .env (nunca se versiona) y completa los valores.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Neon: usa la rama de desarrollo.
# DATABASE_URL = cadena con pooler (para la app); DIRECT_URL = cadena directa (para migraciones).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Autenticación. Genera el secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# La cookie de refresh es Secure solo en producción; ponlo en true/false para forzarlo.
# COOKIE_SECURE=false

# Contraseña de los usuarios de ejemplo que crea "pnpm db:seed" (mínimo 10 caracteres).
# El seed se niega a correr con NODE_ENV=production.
SEED_PASSWORD=

# Opcional: versión que expone /health (en Render se usa RENDER_GIT_COMMIT).
# APP_VERSION=dev
