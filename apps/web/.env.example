# Copia este archivo a .env (nunca se versiona).

# Local/CI: dejar vacío; Vite reenvía /api a API_PROXY_TARGET.
# Staging/producción (Vercel): URL pública de la API en Render, sin barra final.
VITE_API_URL=

# Solo para el servidor de desarrollo y el preview de Vite.
API_PROXY_TARGET=http://localhost:3000
